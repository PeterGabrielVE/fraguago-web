# URL de la API NestJS
# Desarrollo:
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Producción (reemplaza con tu dominio real):
# NEXT_PUBLIC_API_URL="https://api.fraguago.com/api"

# Modo offline: el service worker solo se registra en producción. Para
# probarlo con `pnpm dev`, actívalo aquí (sirve bundles en caché: úsalo solo
# para esa prueba).
# NEXT_PUBLIC_ENABLE_SW=true

# PostHog (analítica). Sin KEY queda desactivado.
# Project API key (phc_...), la misma que POSTHOG_API_KEY de la API.
NEXT_PUBLIC_POSTHOG_KEY=
# US: https://us.i.posthog.com · EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
